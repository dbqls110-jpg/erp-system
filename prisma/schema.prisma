generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── 사용자 ───────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          String    @default("pending") // "admin" | "user" | "pending"
  isAgent       Boolean   @default(false) // true = Agent bot
  agentType     String? // "hermes" | "marketer" | null
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  attendances      Attendance[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  expenses         Expense[]
  businessCards    BusinessCard[]
  calendarEvents   CalendarEvent[]
  conversationsAsA Conversation[]  @relation("ConvA")
  conversationsAsB Conversation[]  @relation("ConvB")
  sentMessages     Message[]       @relation("MessageSender")

  @@map("users")
}

// ─── NextAuth ─────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── 근태 ─────────────────────────────────────────────────
model Attendance {
  id        String    @id @default(cuid())
  userId    String
  date      String // "YYYY-MM-DD"
  clockIn   DateTime?
  clockOut  DateTime?
  workHours Float?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("attendances")
}

// ─── 휴가 ─────────────────────────────────────────────────
model LeaveBalance {
  id          String   @id @default(cuid())
  userId      String
  year        Int
  totalDays   Float    @default(15)
  usedDays    Float    @default(0)
  pendingDays Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id           String   @id @default(cuid())
  userId       String
  type         String // "annual" | "half_am" | "half_pm" | "hourly"
  startDate    String // "YYYY-MM-DD"
  endDate      String // "YYYY-MM-DD"
  startTime    String?
  endTime      String?
  days         Float
  reason       String?
  status       String   @default("pending") // "pending" | "approved" | "rejected"
  adminNote    String?
  notionPageId String? // Notion page ID (승인 시 생성)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("leave_requests")
}

// ─── 프로젝트 ─────────────────────────────────────────────
model Project {
  id           String   @id @default(cuid())
  name         String
  client       String?
  announceDate String?
  deadline     String?
  status       String   @default("active") // "active" | "completed" | "on_hold"
  progress     Float    @default(0)
  assignee     String?
  memo         String?
  revenue      Float? // 매출
  cost         Float? // 매입
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  checklistItems ChecklistItem[]
  files          ProjectFile[]
  customers      ProjectCustomer[]
  partners       ProjectPartner[]

  @@map("projects")
}

model ProjectFile {
  id          String   @id @default(cuid())
  projectId   String
  driveFileId String
  name        String
  mimeType    String
  driveUrl    String
  /**
   * 파일명으로 판정한 종류(견적서·포스터 등). 판정 실패 시 null.
   */
  category    String?
  size        Int?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  projectId   String
  content     String
  isDone      Boolean   @default(false)
  /**
   * 체크한 시각. 체크 해제하면 null 로 되돌린다.
   */
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

// ─── 고정비 ───────────────────────────────────────────────
model FixedExpense {
  id         String   @id @default(cuid())
  name       String
  amount     Float
  dayOfMonth Int // 매달 몇일
  category   String // "rent" | "salary" | "telecom" | "supplies" | "food" | "other"
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("fixed_expenses")
}

// ─── 재무 ─────────────────────────────────────────────────
model Budget {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@map("budgets")
}

model Expense {
  id             String   @id @default(cuid())
  userId         String
  date           String // "YYYY-MM-DD"
  title          String
  category       String // "rent" | "salary" | "telecom" | "supplies" | "food" | "other"
  amount         Float
  memo           String?
  fixedExpenseId String? // 고정비에서 생성된 경우
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([date])
  @@map("expenses")
}

// ─── 메신저 ───────────────────────────────────────────────
model Conversation {
  id            String   @id @default(cuid())
  participantA  String
  participantB  String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  userA    User      @relation("ConvA", fields: [participantA], references: [id], onDelete: Cascade)
  userB    User      @relation("ConvB", fields: [participantB], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([participantA, participantB])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt, senderId])
  @@map("messages")
}

// ─── Agent 감사 로그 ──────────────────────────────────────
model AgentAuditLog {
  id        String   @id @default(cuid())
  method    String // GET | POST | PATCH
  endpoint  String // /api/agent/projects
  action    String // create_project | update_project | send_message ...
  dryRun    Boolean  @default(false)
  payload   Json? // 요청 내용
  result    Json? // 결과 (dryRun이면 예상 결과)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("agent_audit_logs")
}

// ─── 캘린더 ───────────────────────────────────────────────
model CalendarEvent {
  id           String   @id @default(cuid())
  title        String
  date         String // "YYYY-MM-DD"
  endDate      String? // "YYYY-MM-DD"
  color        String   @default("gray") // "gray" | "blue" | "green" | "red" | "yellow" | "purple"
  createdBy    String
  notionPageId String? // Notion page ID (양방향 동기화용)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

// ─── ID 데이터베이스 ──────────────────────────────────────
model Credential {
  id        String   @id @default(cuid())
  name      String // 서비스명
  company   String? // 회사
  category  String? // 구분 (나라장터, Google, Naver, etc.)
  username  String? // 아이디
  password  String? // 비밀번호
  memo      String? // 비고
  url       String? // 링크
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credentials")
}

// ─── 구글 시트 디렉토리 ───────────────────────────────────
model SheetLink {
  id          String  @id @default(cuid())
  name        String
  url         String
  description String?
  category    String?

  /**
   * 우리 소유가 아닌 시트의 소유자 이메일. 우리 것이면 null.
   * 이런 시트는 드라이브에서 부모 폴더가 없고 공유 문서함에 있을 뿐이라, 우리
   * 폴더로 옮길 수 없다. 넣어 봐야 바로가기만 생기고 상대가 지우면 같이 사라진다.
   * 정리가 안 된 것이 아니라 정리할 수 없는 것이므로, 화면에 그렇다고 표시한다.
   * scripts/organize-sheets.mjs 가 채운다.
   */
  externalOwner String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sheet_links")
}

// ─── Agent 메시지 처리 기록 ──────────────────────────────
model AgentMessageProcessing {
  id              String    @id @default(cuid())
  messageId       String
  agentType       String // "hermes" | "marketer"
  status          String    @default("processed") // "processing" | "processed" | "error"
  processedAt     DateTime?
  resultMessageId String? // 답장 messageId
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([messageId, agentType])
  @@index([agentType, createdAt])
  @@map("agent_message_processing")
}

// ─── Agent 기억 ───────────────────────────────────────────
model AgentMemory {
  id        String   @id @default(cuid())
  agentType String // "hermes" | "marketer"
  source    String // "discord" | "erp" | "manual"
  title     String // 짧은 제목/키워드 (최대 100자)
  content   String // 요약된 운영 규칙
  tags      String[] // 태그 배열 (선택)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentType, createdAt])
  @@map("agent_memories")
}

// ─── Agent 실시간 작업 큐 ────────────────────────────────
model AgentJob {
  id        String @id @default(cuid())
  agentType String // "hermes" | "marketer"
  userId    String // 요청자 userId
  status    String @default("pending") // "pending" | "accepted" | "processing" | "completed" | "error"
  input     String // 브릿지에 보낼 프롬프트 전체(지시문 + 주입 자료 + 질문)

  /// 사람이 실제로 친 말.
  ///
  /// input 에는 지시문과 ERP 자료가 함께 들어 있어 화면에 그대로 못 보여준다.
  /// 예전에는 "[질문]" 문자열로 잘라 꺼냈는데, 지시문 문구가 바뀌면 조용히 깨진다.
  /// 그리고 자료가 붙는 질문은 input 이 수십 KB 가 되어, 대화 목록을 불러올 때마다
  /// 그 전부를 실어 나르게 된다.
  userInput   String?
  output      String? // 최종 응답
  errorMsg    String? // 오류 메시지
  claimedAt   DateTime? // 브릿지가 수락한 시각
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sourceMessageId String? @unique // 메신저에서 발생한 job이면 원본 Message.id (없으면 메신저 외부 요청)

  deltas AgentJobDelta[]

  @@index([agentType, status, createdAt])
  @@index([userId, createdAt])
  @@map("agent_jobs")
}

model AgentJobDelta {
  id        String   @id @default(cuid())
  jobId     String
  seq       Int // 순서 번호 (0부터)
  content   String // 부분 출력 텍스트
  createdAt DateTime @default(now())

  job AgentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, seq])
  @@index([jobId, seq])
  @@map("agent_job_deltas")
}

// ─── Agent 브릿지 하트비트 ──────────────────────────────
model AgentBridgeHeartbeat {
  id          String    @id @default(cuid())
  agentType   String    @unique // "hermes" | "marketer"
  lastSeenAt  DateTime  @default(now())
  version     String?
  hostname    String?
  /**
   * 브릿지가 마지막으로 보고한 상태: "idle" | "working" | "error"
   */
  status      String?
  /**
   * 마지막 오류 요약. 회사 PC 로그를 직접 볼 수 없으므로 여기로 올려 받는다.
   */
  lastError   String?
  /**
   * 오류 발생 시각
   */
  lastErrorAt DateTime?
  /**
   * 브릿지가 쓰는 모델·추론강도. 설정이 의도대로인지 확인용.
   */
  model       String?
  effort      String?
  updatedAt   DateTime  @updatedAt

  @@map("agent_bridge_heartbeats")
}

// ─── Google Drive 검색 색인 ───────────────────────────────
// 원본 파일은 Drive에 두고 검색에 필요한 텍스트 조각과 메타데이터만 저장한다.
model DriveIndexFolder {
  id            String    @id @default(cuid())
  driveFolderId String    @unique
  name          String
  webViewLink   String?
  active        Boolean   @default(true)
  allowedRoles  String[]  @default(["admin"])
  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  files DriveIndexFile[]

  @@index([active])
  @@map("drive_index_folders")
}

model DriveIndexFile {
  id            String    @id @default(cuid())
  folderId      String
  driveFileId   String
  name          String
  mimeType      String
  webViewLink   String?
  modifiedTime  DateTime?
  sizeBytes     String?
  status        String    @default("pending") // indexed | metadata_only | skipped | error | deleted
  skipReason    String?
  contentHash   String?
  lastIndexedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  folder DriveIndexFolder  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  chunks DriveIndexChunk[]

  @@unique([folderId, driveFileId])
  @@index([driveFileId])
  @@index([folderId, status])
  @@index([modifiedTime])
  @@map("drive_index_files")
}

model DriveIndexChunk {
  id          String   @id @default(cuid())
  fileId      String
  chunkIndex  Int
  content     String   @db.Text
  contentHash String
  charCount   Int
  createdAt   DateTime @default(now())

  file DriveIndexFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, chunkIndex])
  @@index([fileId])
  @@map("drive_index_chunks")
}

// ─── 명함 ─────────────────────────────────────────────────
model BusinessCard {
  id         String   @id @default(cuid())
  userId     String
  name       String
  company    String?
  jobTitle   String?
  phone      String?
  email      String?
  address    String?
  imagePath  String?
  rawOcrText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_cards")
}

model AccessLevel {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  rank      Int      @default(0)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("access_levels")
}

model MenuAccess {
  id       String @id @default(cuid())
  menuKey  String
  levelKey String

  /// 메뉴에 들어갈 수 있는지. 기존 행은 전부 접근 허용이었으므로 기본값이 true 다.
  canView Boolean @default(true)

  /// 메뉴 안에서 자료를 고칠 수 있는지. 접근보다 좁은 권한이라 기본값은 false 다.
  /// canView 없이 canEdit 만 켜지는 조합은 의미가 없으므로 화면에서 막는다.
  canEdit Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([menuKey, levelKey])
  @@index([menuKey])
  @@map("menu_access")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  manager   String?
  phone     String?
  email     String?
  /**
   * "고객사" | "협력사" | "공급사"
   */
  category  String?
  /**
   * "거래중" | "보류" | "종료"
   */
  status    String   @default("거래중")
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProjectCustomer[]

  @@index([status])
  @@map("customers")
}

/// 파트너는 회사가 아니라 개인이다. 프리랜서 · 외주 인력을 이름 단위로 관리한다.
/// 그래서 담당자(manager)라는 개념이 없다 — 이름 자체가 그 사람이다.
model Partner {
  id String @id @default(cuid())

  /// 사람 이름
  name  String
  /// 직업 · 역할. 예: 사진, 영상, MC, 음향
  job   String?
  phone String?

  /**
   * "활성" | "보류" | "종료"
   * 예전에는 계약상태(진행중/만료/대기)였다. 회사와 계약을 맺는 관계를 전제한 값이라
   * 건별로 부르는 프리랜서에는 맞지 않았다. "만료"보다 "요즘도 같이 일하나"가 실제로
   * 궁금한 것이다. 컬럼 이름은 그대로 두어 마이그레이션을 단순하게 유지한다.
   */
  contractStatus String  @default("활성")
  contractStart  String?
  contractEnd    String?

  /**
   * 단가. 금액과 단위를 나눠 둔다.
   * "50만원/건" 을 문자열 하나로 넣으면 "40만원 이하 사진작가" 같은 조건으로 찾을 수
   * 없다. 숫자로 두어야 비교와 정렬이 된다.
   */
  rate     Int?
  rateUnit String? /// "건당" | "일당" | "시간당"

  /**
   * "월정산" | "건별"
   */
  settlementType String?
  memo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projects ProjectPartner[]

  @@index([contractStatus])
  @@map("partners")
}

/**
 * 프로젝트 ↔ 거래처 (다대다). 비고에 문자열로 적지 않고 관계로 잇는다.
 */
model ProjectCustomer {
  projectId  String
  customerId String
  createdAt  DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([projectId, customerId])
  @@index([customerId])
  @@map("project_customers")
}

model ProjectPartner {
  projectId String
  partnerId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([projectId, partnerId])
  @@index([partnerId])
  @@map("project_partners")
}

/// 대관 공간. 넘겨받은 CSV 는 열이 150개인데, 매칭과 화면에 실제로 쓰는 것만
/// 컬럼으로 두고 나머지는 raw 에 통째로 담는다. 150개를 다 컬럼으로 만들면
/// 대부분이 비어 있는 표가 되고, 원본이 바뀔 때마다 마이그레이션을 해야 한다.
///
/// 같은 건물의 다른 방이 각각 한 행이다. 전화와 주소가 같아도 중복이 아니다.
/// 방마다 정원과 요금이 달라 합치면 안 된다.
model Venue {
  id String @id @default(cuid())

  /// 원본 CSV 의 행을 다시 찾기 위한 열쇠. 원본에 id 가 없어 이름+자치구+위치로 만든다.
  sourceKey String @unique

  name     String
  district String? // 자치구
  address  String? // 원본 '위치'. 층·호·시설명이 붙어 있을 수 있다.
  type     String? // 공연장 · 체육관 · 다목적실 …

  /// 정원. 관람석(seats)과 다른 값이다. 장충체육관 4,507석은 관람석이지 정원이 아니다.
  capacityMin Int?
  capacityMax Int?
  seats       Int? // 관람석
  areaM2      Float? // 실면적

  /// 대표 요금과 그 기준. 기준시간이 공간마다 달라 요금만으로는 비교할 수 없다.
  price            Int?
  priceBasis       String? // 1시간 · 4시간 · 1일 …
  priceSource      String? // 전화확인 > 상업요율 > 공시가 순으로 믿을 만하다
  baseHours        Float?
  overUnit         String?
  overRate         Float?
  overAmount       Int?
  weekendSurcharge Float? // 할증_주말_퍼센트
  vatType          String? // 포함 · 별도 · 면제

  /// 기업 행사의 결격 사유가 되는 칸. 가능 · 불가 · 조건부
  commercialUse String?

  /// 가능 · 불가 · 승인필요 · 미상
  saturday String?
  sunday   String?
  holiday  String?

  /// 요일별 운영 시각 HH:MM
  weekdayOpen  String?
  weekdayClose String?
  satOpen      String?
  satClose     String?
  sunOpen      String?
  sunClose     String?

  /// 설비. Y / N 이며 빈 값은 "언급 없음"이지 "없음"이 아니다.
  beam        String?
  sound       String?
  stage       String?
  lighting    String?
  hvac        String? // 냉난방: 가능 · 별도요금 · 필수신청 · 불가 · 해당없음
  parking     String?
  waitingRoom String?

  /// 야외공간 전용
  electricity String?
  restroom    String?
  rainPlan    String?
  shadeTent   String?
  cooking     String?
  noiseLimit  String?
  rentalItems String?

  phone      String?
  reserveUrl String?

  /// 지도 핀. 카카오 지오코딩으로 채운다. 못 찾은 곳은 null 로 남는다.
  lat       Float?
  lng       Float?
  geoSource String? // 주소 · 이름검색

  /// 전화로 확인한 결과. 사장님이 통화를 시작하면 채워진다.
  calledAt    DateTime?
  calledPrice Int?
  calledNote  String?

  /// 컬럼으로 옮기지 않은 나머지 102개. 원본을 잃지 않기 위해 통째로 담는다.
  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([district])
  @@index([type])
  @@index([capacityMax])
  @@map("venues")
}
