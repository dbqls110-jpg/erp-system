# 회사 PC 브릿지 설정. 이 파일을 bridge.env 로 복사한 뒤 값을 채운다.
# bridge.env 는 절대 커밋하지 않는다(.gitignore 에 등록됨).

# ERP 주소
ERP_BASE_URL=https://erp-system-lojo.onrender.com

# 이 브릿지가 담당할 에이전트: hermes | marketer
AGENT_TYPE=hermes

# Render 대시보드 > Environment 의 HERMES_BRIDGE_API_KEY 값을 그대로 붙여넣는다.
BRIDGE_API_KEY=

# Codex 실행 설정.
# 실측(대관 견적 계산, 검산 포함): medium 15초 / high 16초 / xhigh 18초.
# 차이가 3초뿐이고 xhigh 의 출력이 가장 정제돼 있어 xhigh 를 기본으로 둔다.
# 유효값: none · minimal · low · medium · high · xhigh
# (max 는 없는 값이다. 넣으면 경고만 남기고 medium 으로 떨어진다.)
CODEX_MODEL=gpt-5.6-luna
CODEX_EFFORT=xhigh

# 작업 확인 주기(초)와 하트비트 주기(초)
POLL_INTERVAL_SEC=5
HEARTBEAT_INTERVAL_SEC=30
