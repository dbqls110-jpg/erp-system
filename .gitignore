# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage/

# next.js
/.next/
**/.next/
/out/
**/out/

# production
/build
**/build/
**/dist/

# misc
.DS_Store

# secret material (never commit)
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.secret
*.secrets
*.credential
*.credentials
*password.json
*passwords.json
*secret*.json
*credential*.json
*credentials*.json
*service-account*.json
*service_account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# agent_bridge local runtime files (contain secrets / local state)
agent_bridge/hermes.env
agent_bridge/marketer.env
agent_bridge/*.log
agent_bridge/*.lock
agent_bridge/*.pid
agent_bridge/*.tmp
agent_bridge/__pycache__/
agent_bridge/**/__pycache__/
agent_bridge/.pytest_cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# SQLite
*.db
*.db-journal

# 보관본에 실제 시크릿이 딸려 들어가지 않도록
archive/**/*.env

# 브릿지 시크릿
bridge/bridge.env

# 파이썬 스크립트 캐시
__pycache__/
